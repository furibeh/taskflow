{
  "name": "@taskflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:migrate:down": "tsx src/cli/migrate.ts down",
    "board:init": "tsx src/cli/board-init.ts",
    "board:create": "tsx src/cli/board-create.ts",
    "board:rotate": "tsx src/cli/board-rotate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@taskflow/contracts": "0.1.0",
    "@taskflow/domain": "0.1.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
