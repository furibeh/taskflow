# Valores de ejemplo para desarrollo local. Copia este archivo a .env y cámbialos.
# No pongas secretos reales aquí: este archivo se sube al repositorio.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow
DATABASE_URL=postgres://taskflow:change-me@localhost:5432/taskflow
TEST_DATABASE_URL=postgres://taskflow:change-me@localhost:5433/taskflow_test
API_PORT=3000
PUBLIC_WEB_URL=http://localhost:5173
LOG_LEVEL=info
# Límites de peticiones por IP y minuto (opcionales; mínimo 1, no se pueden desactivar).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_WRITES=60
RATE_LIMIT_UNAUTHORIZED=20
# Proxies de confianza (IP o CIDR, separados por comas) para conocer la IP real del cliente.
# Docker Compose ya lo fija para su proxy web; fuera de Compose, p. ej.: TRUST_PROXY=127.0.0.1,::1
# TRUST_PROXY=
# Creación de tableros desde la web (plan D12): false la desactiva; límite de creaciones nuevas
# por IP y hora (mínimo 1).
BOARD_CREATION_ENABLED=true
BOARD_CREATION_PER_HOUR=10
